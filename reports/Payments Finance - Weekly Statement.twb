      <aliases enabled='yes' />
      <column caption='Favorable Direction' datatype='string' name='[Calculation_0052822377570304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([metric], &quot;refund&quot;) OR CONTAINS([metric], &quot;failed&quot;) THEN&#13;&#10;    IF [wow_change_pct] &lt;= 0 THEN &quot;Favorable&quot; ELSE &quot;Unfavorable&quot; END&#13;&#10;ELSE&#13;&#10;    IF [wow_change_pct] &gt;=0 THEN &quot;Favorable&quot; ELSE &quot;Unfavorable&quot; END&#13;&#10;END' />
      </column>
      <column caption='Scorecard Label' datatype='string' name='[Calculation_0052822379843585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([this_week], 0)) + &quot;   (&quot; + &#13;&#10;IF [wow_change_pct] &gt; 0 THEN &quot;+&quot; ELSE &quot;&quot; END + &#13;&#10;STR(ROUND([wow_change_pct], 1)) + &quot;% WoW)&quot;' />
      </column>
      <column caption='kpi_weekly_snapshot.csv' datatype='table' name='[__tableau_internal_object_id__].[kpi_weekly_snapshot.csv_B1E7FE72CF5E4ED09CCC6F918CEB1ABF]' role='measure' type='quantitative' />
